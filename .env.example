# This repository is a BROWSER-LOCAL PROTOTYPE, not a production commerce backend.
# To use the admin and checkout test flows in a *clearly labeled* demo build:
VITE_ENABLE_DEMO_MODE=true
# For GitHub Pages, GitHub Actions sets these automatically:
# VITE_ROUTER_MODE=hash
# VITE_BASE_PATH=/selsabil-delivery/

# OPTIONAL: Firebase SDK client configuration. Does NOT enable secure login,
# Firestore persistence, or real purchasing by itself.
# Only set these after configuring Firebase security rules and backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
